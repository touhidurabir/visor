# Refuse package versions published less than 7 days ago, reducing exposure
# to freshly compromised or malicious releases (npm 11 `min-release-age`, in days).
min-release-age=7
# @wailsio/runtime is pinned to match the Go module github.com/wailsapp/wails/v3;
# both are bumped together on purpose, so it is exempt.
min-release-age-exclude[]=@wailsio/runtime

# Pin exact versions (project rule: no ^ or ~ ranges).
save-exact=true
