<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="visor"
        Arguments=""
        InstallLocation="C:\Program Files\Touhidur Rahman\Visor">
    </Installer>
    <PackageInformation
        PackageName="Visor"
        PackageDisplayName="Visor"
        PublisherName="CN=Touhidur Rahman"
        PublisherDisplayName="Touhidur Rahman"
        Version="0.0.1.0"
        PackageDescription="A macOS menu-bar app for managing supervisord">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.getvisor.visor"
                Description="A macOS menu-bar app for managing supervisord"
                DisplayName="Visor"
                ExecutableName="visor"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Visor</DisplayName>
            <PublisherDisplayName>Touhidur Rahman</PublisherDisplayName>
            <Description>A macOS menu-bar app for managing supervisord</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="visor.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
